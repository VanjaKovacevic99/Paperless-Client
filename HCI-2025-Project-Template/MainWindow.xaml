<Window x:Class="HCI_2025_Project_Template.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:lvcCore="clr-namespace:LiveChartsCore.SkiaSharpView;assembly=LiveChartsCore.SkiaSharpView"
        xmlns:local="clr-namespace:HCI_2025_Project_Template"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:conv="clr-namespace:HCI_2025_Project_Template.Converters"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Title="Paperless Client"
        Height="600"
        Width="900"
        Background="{DynamicResource MaterialDesignPaper}"
        Icon="/Resources/Images/favicon.png">
    <Window.Resources>
        <conv:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Blue"/>
                    <!-- Opciono: i boja teksta -->
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid Margin="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===================== -->
            <!-- LEFT SIDEBAR -->
            <!-- ===================== -->
            <Border Grid.Column="0"
                Background="{DynamicResource MaterialDesignCardBackground}"
                CornerRadius="8"
                Padding="10"
                Margin="0,0,10,0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock 
                        Text="{DynamicResource Menu}"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="10"
                           Foreground="#333"/>

                    <Button  x:Name="BtnDocuments"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
        Click="Documents_Click"
        Style="{StaticResource MaterialDesignFlatButton}"
                        
        Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileDocumentOutline"/>
                            <TextBlock Text="{DynamicResource Documents}"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnUpload" 
                        Grid.Row="2"
                       HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
        Click="Upload_Click"
        Style="{StaticResource MaterialDesignFlatButton}"
        Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Upload"/>
                            <TextBlock Text="{DynamicResource Upload}"/>
                        </StackPanel>
                    </Button>



                    <Button x:Name="BtnTags"
                        Grid.Row="3"
                       HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        Click="Tags_Click"
        Style="{StaticResource MaterialDesignFlatButton}"
                      
        Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TagOutline"/>
                            <TextBlock Text="{DynamicResource Tags}"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnAnalytics"
                        Grid.Row="4"

                        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        Click="Analytics_Click"
        Style="{StaticResource MaterialDesignFlatButton}"
        Margin="5">

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartBar"
                                  Width="18"
                                  Height="18"
                                  Margin="0,0,5,0"/>
                            <TextBlock Text="{DynamicResource Analytics}"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnSettings"
                        Grid.Row="5"
                        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        Click="Settings_Click"
        Style="{StaticResource MaterialDesignFlatButton}"
        Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CogOutline"/>
                            <TextBlock Text="{DynamicResource Settings}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnLogout"
        Grid.Row="6"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        Click="Logout_Click"
        Style="{StaticResource MaterialDesignFlatButton}"
        Margin="5">

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Logout"/>
                            <TextBlock Text="{DynamicResource Logout}"
                   Margin="5,0,0,0"/>
                        </StackPanel>

                    </Button>

                </Grid>

            </Border>

            <!-- ===================== -->
            <!-- RIGHT MAIN CONTENT -->
            <!-- ===================== -->
            <Grid Grid.Column="1"  Visibility="{Binding IsDocuments, Converter={StaticResource BooleanToVisibilityConverter}}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">

                    <TextBlock Grid.Row="0" Text="{DynamicResource Documents}" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                    <!-- SEARCH WRAPPER -->
                    <Grid Margin="0,0,0,10">

                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Center"
                 VerticalContentAlignment="Center"
                 materialDesign:HintAssist.Hint="{DynamicResource Search}"
                 Height="35"
                 Padding="30,0,0,0"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                        <!-- ICON (LOUPE) -->
                        <materialDesign:PackIcon Kind="Magnify"
                                 Width="20"
                                 Height="20"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Left"
                                 Margin="10,0,0,0"/>
                    </Grid>

                    <!-- FILTERS -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,10">

                        <ComboBox Width="180"
                  ItemsSource="{Binding Tags}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedTag}"
                  materialDesign:HintAssist.Hint="{DynamicResource Tag}"/>

                        <ComboBox Width="180"
                  Margin="10,0,0,0"
                  ItemsSource="{Binding DocumentTypes}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedType}"
                  materialDesign:HintAssist.Hint="{DynamicResource Type}"/>

                        <ComboBox Width="180"
                  Margin="10,0,0,0"
                  ItemsSource="{Binding Correspondents}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedCorrespondent}"
                  materialDesign:HintAssist.Hint="{DynamicResource Correspondent}"/>

                        <Button Content="{DynamicResource Reset}"
                Margin="10,0,0,0"
                Style="{StaticResource MaterialDesignOutlinedButton}"
                Click="ResetFilters_Click"/>

                    </StackPanel>

                </StackPanel>

                <!-- ================= TAB CONTENT ================= -->
                <TabControl Grid.Row="1"
                        Style="{StaticResource MaterialDesignTabControl}"
                        >

                    <!-- TABLE -->
                    <TabItem Header="{DynamicResource Table}">

                        <DataGrid ItemsSource="{Binding Documents}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              MouseDoubleClick="DocumentsGrid_MouseDoubleClick">
                            <DataGrid.Columns>

                                <DataGridTextColumn Binding="{Binding Title}"
                        Width="*">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{DynamicResource Title}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding CreatedDisplay}"
                        Width="200">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{DynamicResource Created}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding TagNamesDisplay}"
                        Width="200">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{DynamicResource Tags}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding DocumentTypeName}"
                        Width="150">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{DynamicResource Type}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                    </TabItem>


                    <!-- CARDS -->
                    <TabItem Header="{DynamicResource Cards}">

                        <ScrollViewer>

                            <ItemsControl ItemsSource="{Binding Documents}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <materialDesign:Card Width="220"
                                                         Margin="10"
                                                         Padding="10"
                                                         Background="White"
                                                         MouseDoubleClick="Card_MouseDoubleClick">

                                            <StackPanel>
                                                <Border Height="120"
                Margin="0,0,0,10"
                CornerRadius="5"
                ClipToBounds="True">
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                </Border>

                                                <TextBlock Text="{Binding Title}"
                                                       FontSize="16"
                                                       FontWeight="Bold"/>

                                                <TextBlock Text="{Binding CreatedDisplay}"
                                                       Opacity="0.6"/>

                                                <TextBlock Text="{Binding TagNamesDisplay}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0"/>

                                                <TextBlock Text="{Binding DocumentTypeName}"
                                                       FontStyle="Italic"
                                                       Opacity="0.7"/>

                                            </StackPanel>

                                        </materialDesign:Card>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </ScrollViewer>

                    </TabItem>

                </TabControl>

                <!-- ================= PAGINATION ================= -->
                <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="10">
                    <Button Click="Prev_Click"
        IsEnabled="{Binding HasPreviousPage}"
        Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◀" Margin="0,0,5,0"/>
                            <TextBlock Text="{DynamicResource Previous}"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="{Binding PageInfo}"
           Margin="10"
           VerticalAlignment="Center"/>

                    <Button Click="Next_Click"
        IsEnabled="{Binding HasNextPage}"
        Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Next}"/>
                            <TextBlock Text="▶" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </Grid>
            <Grid Grid.Column="1"   Visibility="{Binding IsUpload, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Padding="60,40,60,40">
                    <StackPanel HorizontalAlignment="Stretch" >

                        <TextBlock Text="{DynamicResource UploadDocument}"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

                        <!-- TITLE -->
                        <TextBox Text="{Binding Upload.Title, UpdateSourceTrigger=PropertyChanged}"
                 materialDesign:HintAssist.Hint="{DynamicResource Title}"
                 Margin="0,0,0,10"/>

                        <!-- TAG -->
                        <ComboBox ItemsSource="{Binding Tags}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding Upload.Tag}"
                  materialDesign:HintAssist.Hint="{DynamicResource Tag}"
                  Margin="0,0,0,10"/>

                        <!-- TYPE -->
                        <ComboBox ItemsSource="{Binding DocumentTypes}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding Upload.Type}"
                  materialDesign:HintAssist.Hint="{DynamicResource Type}"
                  Margin="0,0,0,10"/>

                        <!-- CORRESPONDENT -->
                        <ComboBox ItemsSource="{Binding Correspondents}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding Upload.Correspondent}"
                  materialDesign:HintAssist.Hint="{DynamicResource Correspondent}"
                  Margin="0,0,0,20"/>

                        <!-- FILE SECTION (LAST) -->
                        <Border BorderBrush="#DDD"
                BorderThickness="1"
                Padding="15"
                CornerRadius="8"
                Background="#FAFAFA"
                AllowDrop="True"
                Drop="File_Drop">

                            <StackPanel HorizontalAlignment="Center">

                                <TextBlock Text="Drag &amp; drop file "
                           HorizontalAlignment="Center"
                           Opacity="0.7"
                           Margin="0,0,0,10"/>

                                <TextBlock Text="{Binding UploadFileName}"
                           HorizontalAlignment="Center"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                                <Button Content="{DynamicResource ChooseFile}"
                        Width="150"
                        Click="ChooseFile_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}"/>

                            </StackPanel>

                        </Border>

                        <!-- UPLOAD BUTTON -->
                        <Button Content="{DynamicResource Create}"
                Margin="0,20,0,0"
                Height="40"
                Style="{StaticResource MaterialDesignRaisedButton}"
                Click="UploadFile_Click"/>

                    </StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Column="1"
      Visibility="{Binding IsTags, Converter={StaticResource BooleanToVisibilityConverter}}"
      Margin="40">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- NASLOV -->
                <TextBlock Grid.Row="0"
               Text="{DynamicResource Tags}"
               FontSize="20"
               FontWeight="Bold"
               Margin="0,0,0,20"/>

                <!-- GLAVNI SADRŽAJ -->
                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <!-- TABELA -->
                        <ColumnDefinition Width="2*"/>

                        <!-- FORMA -->
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>


                    <!-- ================= LEFT: TABELA TAGOVA ================= -->
                    <DataGrid Grid.Column="0"
                  ItemsSource="{Binding Tags1}"
                  SelectedItem="{Binding CrudTag}"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  BorderThickness="1"
                  BorderBrush="#DDD"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Margin="0,0,20,0">

                        <DataGrid.Columns>

                            <!-- BOJA -->
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="{DynamicResource Color}" />
                                </DataGridTemplateColumn.Header>

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="5">

                                            <Ellipse Width="16"
                                         Height="16"
                                         Fill="{Binding Color, Converter={StaticResource ColorToBrushConverter}}"
                                         Margin="0,0,8,0"/>

                                            <TextBlock Text="{Binding Color}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="Gray"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>


                            <!-- NAZIV -->
                            <DataGridTextColumn Binding="{Binding Name}"
                                    Width="*">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource Name}" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>


                            <!-- IZMIJENI -->
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{DynamicResource Edit}"
                                    Click="EditTag_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Margin="5,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>


                            <!-- OBRIŠI -->
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{DynamicResource Delete}"
                                    Click="DeleteTag_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Margin="5,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>


                    <!-- ================= RIGHT: JEDINSTVENA FORMA ================= -->
                    <Border Grid.Column="1"
                Padding="20"
                BorderBrush="#DDD"
                BorderThickness="1"
                CornerRadius="8"
                Background="{DynamicResource MaterialDesignCardBackground}">

                        <StackPanel>

                            <!-- NASLOV SE MIJENJA -->
                            <TextBlock Text="{Binding TagFormTitle}"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>


                            <!-- NAZIV -->
                            <TextBox Text="{Binding TagFormName, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="{DynamicResource TagName}"
                         Margin="0,0,0,15"/>


                            <!-- BOJA -->
                            <TextBlock Text="{DynamicResource Color}"
                           Margin="0,0,0,5"/>

                            <materialDesign:ColorPicker
                         Color="{Binding TagFormColor, Mode=TwoWay}"
                            HorizontalAlignment="Stretch"
                        Height="100"
                            Margin="0,0,0,20"/>
    


                            <!-- GLAVNO DUGME: DODAJ / SAČUVAJ -->
                            <Button Content="{Binding TagFormButtonText}"
                        Click="SaveTag_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,0,10"/>


                            <!-- OTKAŽI -->
                            <Button Content="{DynamicResource Cancel}"
                        Click="CancelTagEdit_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </Grid>

            <Grid Grid.Column="1"  Visibility="{Binding IsAnalytics, Converter={StaticResource BooleanToVisibilityConverter}}">




                <Grid.RowDefinitions>
                    <!-- GORE: TABOVI -->
                    <RowDefinition Height="4*"/>

                    <!-- DOLE: TABELA -->
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ===================== -->
                <!-- TABOVI: PIE / BAR / TAGS -->
                <!-- ===================== -->
                <TabControl Grid.Row="0">

                    <!-- PIE CHART -->
                    <TabItem Header="Pie">

                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <lvc:PieChart
                         Grid.Row="0"
                        Series="{Binding PieSeries}"
                        LegendPosition="Right"
                        TooltipPosition="Top"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        DataPointerDown="PieChart_DataPointerDown"/>
                        </Grid>
                    </TabItem>


                    <!-- BAR CHART -->
                    <TabItem Header="Bar">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <ComboBox Grid.Row="0"
                          Margin="5"
                          ItemsSource="{Binding Years}"
                          SelectedItem="{Binding SelectedYear}" 
                           />

                            <lvc:CartesianChart Grid.Row="1"
                                    Margin="5"
                                    Series="{Binding BarSeries}"
                                    XAxes="{Binding XAxes}"
                                    YAxes="{Binding YAxes}" 
                                    DataPointerDown="BarChart_DataPointerDown"/>
                        </Grid>
                    </TabItem>

                    <!-- TAG CLOUD -->
                    <TabItem Header="Tags">
                        <Grid x:Name="TagCloudContainer"  SizeChanged="TagCloudContainer_SizeChanged">
                            <Canvas x:Name="TagPanel"
                         Background="Transparent"
                            ClipToBounds="True"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            />
                        </Grid>
                    </TabItem>

                </TabControl>

                <!-- ===================== -->
                <!-- TABELA ISPOD -->
                <!-- ===================== -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding Documents}"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            MouseDoubleClick="DocumentsGrid_MouseDoubleClick">
                    <DataGrid.Columns>

                        <DataGridTextColumn Binding="{Binding Title}"
      Width="*">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Title}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding CreatedDisplay}"
      Width="200">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Created}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding TagNamesDisplay}"
      Width="200">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Tags}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding DocumentTypeName}"
      Width="150">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Type}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                    </DataGrid.Columns>

                </DataGrid>
                <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="10">
                    <Button Click="Prev_Click"
IsEnabled="{Binding HasPreviousPage}"
Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◀" Margin="0,0,5,0"/>
                            <TextBlock Text="{DynamicResource Previous}"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="{Binding PageInfo}"
   Margin="10"
   VerticalAlignment="Center"/>

                    <Button Click="Next_Click"
IsEnabled="{Binding HasNextPage}"
Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Next}"/>
                            <TextBlock Text="▶" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Grid Grid.Row="3">
                    <Button Content="{DynamicResource Reset}"
                    Margin="10,0,0,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Click="ResetFilters_Click"/>
                </Grid>


            </Grid>


            <Grid Grid.Column="1"
      Visibility="{Binding IsSettings, Converter={StaticResource BooleanToVisibilityConverter}}">

                <StackPanel Margin="100">

                    <TextBlock Text="{DynamicResource Settings}"
               FontSize="22"
               FontWeight="Bold"
               Margin="0,0,0,20"/>

                    <!-- THEME -->
                    <TextBlock Text="{DynamicResource Theme}"
               Margin="0,10,0,5"/>
                    <ComboBox SelectedValue="{Binding Settings.Theme, Mode=TwoWay}"
          SelectedValuePath="Content">
                        <ComboBoxItem Content="Light"/>
                        <ComboBoxItem Content="Dark"/>
                    </ComboBox>

                    <!-- LANGUAGE -->
                    <TextBlock Text="{DynamicResource Language}"
            Margin="0,15,0,5"/>

                    <ComboBox SelectedValue="{Binding Settings.Language, Mode=TwoWay}"
                    SelectedValuePath="Content">
                        <ComboBoxItem Content="en"/>
                        <ComboBoxItem Content="sr"/>
                    </ComboBox>

                    <!-- COLOR -->
                    <TextBlock Text="{DynamicResource AccentColor}"
               Margin="0,15,0,5"/>

                    <materialDesign:ColorPicker
             Color="{Binding SelectedColor, Mode=TwoWay}"
            Height="100"/>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                         Click="SaveSettings_Click" Content="{DynamicResource Save}"/>

                </StackPanel>
            </Grid>


        </Grid>
        <Grid Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
Background="#80000000"
Panel.ZIndex="999"
HorizontalAlignment="Stretch"
VerticalAlignment="Stretch">

            <Grid HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

                <Border HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Padding="20"
          Background="#AA000000"
          CornerRadius="10">

                    <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                        <ProgressBar IsIndeterminate="True"
                       Width="300"
                       Height="4"
                       Margin="0,0,0,10"/>

                        <TextBlock Text="Loading..."
                     Foreground="White"
                     HorizontalAlignment="Center"/>
                    </StackPanel>

                </Border>

            </Grid>
        </Grid>
    </Grid>
</Window>