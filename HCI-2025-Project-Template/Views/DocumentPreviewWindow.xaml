<Window x:Class="HCI_2025_Project_Template.Views.DocumentPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:HCI_2025_Project_Template.Views"
        mc:Ignorable="d"
        Title="DocumentPreviewWindow" Height="450" Width="800">
    <Grid>
        <Grid Margin="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: METADATA -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">

                <TextBlock Text="{Binding Title}"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

                <TextBlock Text="Created:" FontWeight="Bold"/>
                <TextBlock Text="{Binding CreatedDisplay}" Margin="0,0,0,10"/>

                <TextBlock Text="Type:" FontWeight="Bold"/>
                <TextBlock Text="{Binding DocumentTypeName}" Margin="0,0,0,10"/>

                <TextBlock Text="Tags:" FontWeight="Bold"/>
                <TextBlock Text="{Binding TagNamesDisplay}"
                       TextWrapping="Wrap"/>
            </StackPanel>

            <!-- RIGHT: PREVIEW -->
            <Border Grid.Column="1"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10">

                <!-- placeholder preview -->
                <!-- RIGHT: preview -->
                <wv2:WebView2 x:Name="PdfView"
                  Grid.Column="1"/>
            </Border>

        </Grid>

    </Grid>
</Window>
