<Window x:Class="HCI_2025_Project_Template.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HCI_2025_Project_Template"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Title="MainWindow" Height="450" Width="800">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="1">

            <TabItem Header="Tabela">
                <DataGrid x:Name="DocumentsGrid"
                      Margin="10"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">

                    <DataGrid.Columns>
                        
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedDisplay}" Width="*"/>
                        <DataGridTextColumn Header="Tags" Binding="{Binding TagNamesDisplay}" Width="200"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding DocumentTypeName}" Width="*"/>
                    </DataGrid.Columns>

                </DataGrid>
            </TabItem>

            <!-- 🟢 KARTIČNI PRIKAZ -->
            <TabItem Header="Kartice">
                <ScrollViewer>
                    <ItemsControl x:Name="DocumentsCards">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="Gray"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10"
                                    Margin="10"
                                    Width="200">

                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                               FontWeight="Bold"
                                               FontSize="14"/>

                                        <TextBlock Text="{Binding CreatedDisplay}"
                                               FontSize="12"/>
                                        <TextBlock Text="{Binding TagNamesDisplay}"
                                         FontSize="12"/>
                                        <TextBlock Text="{Binding DocumentTypeName}"
                                         FontSize="12"/>
                                    </StackPanel>

                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
