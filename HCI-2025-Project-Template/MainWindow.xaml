<Window x:Class="HCI_2025_Project_Template.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:HCI_2025_Project_Template"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Title="Paperless Client"
        Height="600"
        Width="900"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== -->
        <!-- LEFT SIDEBAR -->
        <!-- ===================== -->
        <Border Grid.Column="0"
                Background="#FAFAFA"
                CornerRadius="8"
                Padding="10"
                Margin="0,0,10,0">

            <StackPanel>

                <TextBlock Text="MENU"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="10"
                           Foreground="#333"/>

                <Button Content="📄 Documents"
                        HorizontalAlignment="Left"
        Click="Documents_Click"
        Style="{StaticResource MaterialDesignFlatButton}"
        Margin="5"/>

                <Button Content="⬆ Upload"
                        HorizontalAlignment="Left"
        Click="Upload_Click"
        Style="{StaticResource MaterialDesignFlatButton}"
        Margin="5"/>

                <Button Content="🏷 Tags"
                        HorizontalAlignment="Left"
        Click="Tags_Click"
        Style="{StaticResource MaterialDesignFlatButton}"
        Margin="5"/>

                <Button Content="⚙ Settings"
                        HorizontalAlignment="Left"
        Click="Settings_Click"
        Style="{StaticResource MaterialDesignFlatButton}"
        Margin="5"/>

            </StackPanel>

        </Border>

        <!-- ===================== -->
        <!-- RIGHT MAIN CONTENT -->
        <!-- ===================== -->
        <Grid Grid.Column="1"  Visibility="{Binding IsDocuments, Converter={StaticResource BooleanToVisibilityConverter}}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">

                <!-- TITLE -->
                <TextBlock Text="📄 Paperless-NGX Desktop Client"
               FontSize="22"
               FontWeight="Bold"
               Margin="0,0,0,10"/>

                <!-- SEARCH WRAPPER -->
                <Grid Margin="0,0,0,10">

                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Center"
                 VerticalContentAlignment="Center"
                 materialDesign:HintAssist.Hint="Search documents..."
                 Height="35"
                 Padding="30,0,0,0"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                    <!-- ICON (LOUPE) -->
                    <materialDesign:PackIcon Kind="Magnify"
                                 Width="20"
                                 Height="20"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Left"
                                 Margin="10,0,0,0"/>
                </Grid>

                <!-- FILTERS -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,10">

                    <ComboBox Width="180"
                  ItemsSource="{Binding Tags}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedTag}"
                  materialDesign:HintAssist.Hint="Tag"/>

                    <ComboBox Width="180"
                  Margin="10,0,0,0"
                  ItemsSource="{Binding DocumentTypes}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedType}"
                  materialDesign:HintAssist.Hint="Type"/>

                    <ComboBox Width="180"
                  Margin="10,0,0,0"
                  ItemsSource="{Binding Correspondents}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedCorrespondent}"
                  materialDesign:HintAssist.Hint="Correspondent"/>

                    <Button Content="Reset"
                Margin="10,0,0,0"
                Style="{StaticResource MaterialDesignOutlinedButton}"
                Click="ResetFilters_Click"/>

                </StackPanel>

            </StackPanel>

            <!-- ================= TAB CONTENT ================= -->
            <TabControl Grid.Row="1"
                        Style="{StaticResource MaterialDesignTabControl}"
                        >

                <!-- TABLE -->
                <TabItem Header="Table">

                    <DataGrid ItemsSource="{Binding Documents}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              MouseDoubleClick="DocumentsGrid_MouseDoubleClick">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Title"
                                                Binding="{Binding Title}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Created"
                                                Binding="{Binding CreatedDisplay}"
                                                Width="200"/>
                            <DataGridTextColumn Header="Tags"
                                                Binding="{Binding TagNamesDisplay}"
                                                Width="200"/>
                            <DataGridTextColumn Header="Type"
                                                Binding="{Binding DocumentTypeName}"
                                                Width="150"/>
                        </DataGrid.Columns>

                    </DataGrid>

                </TabItem>

                <!-- CARDS -->
                <TabItem Header="Cards">

                    <ScrollViewer>

                        <ItemsControl ItemsSource="{Binding Documents}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <materialDesign:Card Width="220"
                                                         Margin="10"
                                                         Padding="10"
                                                         Background="White"
                                                         MouseDoubleClick="Card_MouseDoubleClick">

                                        <StackPanel>

                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="16"
                                                       FontWeight="Bold"/>

                                            <TextBlock Text="{Binding CreatedDisplay}"
                                                       Opacity="0.6"/>

                                            <TextBlock Text="{Binding TagNamesDisplay}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0"/>

                                            <TextBlock Text="{Binding DocumentTypeName}"
                                                       FontStyle="Italic"
                                                       Opacity="0.7"/>

                                        </StackPanel>

                                    </materialDesign:Card>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </TabItem>

            </TabControl>

            <!-- ================= PAGINATION ================= -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="10">

                <Button Content="◀ Prev"
                        Click="Prev_Click"
                        IsEnabled="{Binding HasPreviousPage}"
                        Margin="5"/>

                <TextBlock Text="{Binding PageInfo}"
                           Margin="10"
                           VerticalAlignment="Center"/>

                <Button Content="Next ▶"
                        Click="Next_Click"
                        IsEnabled="{Binding HasNextPage}"
                        Margin="5"/>

            </StackPanel>

        </Grid>
        <Grid Grid.Column="1"   Visibility="{Binding IsUpload, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Padding="60,40,60,40">
                <StackPanel HorizontalAlignment="Stretch" >

                <TextBlock Text="Upload document"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

                <!-- TITLE -->
                <TextBox Text="{Binding Upload.Title, UpdateSourceTrigger=PropertyChanged}"
                 materialDesign:HintAssist.Hint="Title"
                 Margin="0,0,0,10"/>

                <!-- TAG -->
                <ComboBox ItemsSource="{Binding Tags}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding Upload.Tag}"
                  materialDesign:HintAssist.Hint="Tag"
                  Margin="0,0,0,10"/>

                <!-- TYPE -->
                <ComboBox ItemsSource="{Binding DocumentTypes}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding Upload.Type}"
                  materialDesign:HintAssist.Hint="Type"
                  Margin="0,0,0,10"/>

                <!-- CORRESPONDENT -->
                <ComboBox ItemsSource="{Binding Correspondents}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding Upload.Correspondent}"
                  materialDesign:HintAssist.Hint="Correspondent"
                  Margin="0,0,0,20"/>

                <!-- FILE SECTION (LAST) -->
                <Border BorderBrush="#DDD"
                BorderThickness="1"
                Padding="15"
                CornerRadius="8"
                Background="#FAFAFA"
                AllowDrop="True"
                Drop="File_Drop">

                    <StackPanel HorizontalAlignment="Center">

                        <TextBlock Text="Drag &amp; drop file "
                           HorizontalAlignment="Center"
                           Opacity="0.7"
                           Margin="0,0,0,10"/>

                        <TextBlock Text="{Binding UploadFileName}"
                           HorizontalAlignment="Center"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                        <Button Content="Choose file"
                        Width="150"
                        Click="ChooseFile_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}"/>

                    </StackPanel>

                </Border>

                <!-- UPLOAD BUTTON -->
                <Button Content="Upload"
                Margin="0,20,0,0"
                Height="40"
                Style="{StaticResource MaterialDesignRaisedButton}"
                Click="UploadFile_Click"/>

            </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Column="1"  Visibility="{Binding IsTags, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock>Ovo je tag</TextBlock>
        </Grid>
        <Grid Grid.Column="1"  Visibility="{Binding IsSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock>Ovo je settings</TextBlock>
        </Grid>


    </Grid>
</Window>