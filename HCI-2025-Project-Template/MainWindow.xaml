<Window x:Class="HCI_2025_Project_Template.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:HCI_2025_Project_Template"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Title="Paperless Client"
        Height="600"
        Width="900"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

       
        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">

            <!-- TITLE -->
            <TextBlock Text="📄 Paperless-NGX Desktop Client"
               FontSize="22"
               FontWeight="Bold"
               Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    
                </Grid.ColumnDefinitions>

                <!-- SEARCH -->
                <TextBox 
             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
             VerticalAlignment="Center"
             VerticalContentAlignment="Center"
             materialDesign:HintAssist.Hint="Search documents..."
             Margin="5,0,0,0"
             Padding="30,0,0,0"
             Height="35"    
             Style="{StaticResource MaterialDesignOutlinedTextBox}" TextChanged="TextBox_TextChanged"/>
            
            <materialDesign:PackIcon Kind="Magnify"
                                    
                             Width="20"
                             Height="20"
                             VerticalAlignment="Center"
                             Margin="10,0,0,0"
                             HorizontalAlignment="Left"/>
            </Grid>
        </StackPanel>

        <!-- MAIN CONTENT -->
        <TabControl Grid.Row="1"
                    Style="{StaticResource MaterialDesignTabControl}">

            <!-- TABLE VIEW -->
            <TabItem Header="Table">

                <DataGrid ItemsSource="{Binding Documents}"
                          Margin="10"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Style="{StaticResource MaterialDesignDataGrid}">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Title"
                                            Binding="{Binding Title}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Created"
                                            Binding="{Binding CreatedDisplay}"
                                            Width="200"/>

                        <DataGridTextColumn Header="Tags"
                                            Binding="{Binding TagNamesDisplay}"
                                            Width="200"/>

                        <DataGridTextColumn Header="Type"
                                            Binding="{Binding DocumentTypeName}"
                                            Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>

            </TabItem>

            <!-- CARD VIEW -->
            <TabItem Header="Cards">

                <ScrollViewer>

                    <ItemsControl ItemsSource="{Binding Documents}">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <materialDesign:Card Width="220"
                                                     Margin="10"
                                                     Padding="10"
                                                     UniformCornerRadius="8">

                                    <StackPanel>

                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,5"/>

                                        <TextBlock Text="{Binding CreatedDisplay}"
                                                   Opacity="0.7"/>

                                        <TextBlock Text="{Binding TagNamesDisplay}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0"/>

                                        <TextBlock Text="{Binding DocumentTypeName}"
                                                   FontStyle="Italic"
                                                   Opacity="0.8"/>

                                    </StackPanel>

                                </materialDesign:Card>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </ScrollViewer>

            </TabItem>

        </TabControl>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="10"
            VerticalAlignment="Center">

            <!-- Page size -->
            <TextBlock Text="Page size:"
               VerticalAlignment="Center"
               Margin="5"/>

            <ComboBox Width="70"
                      SelectedIndex="0"
          SelectedItem="{Binding PageSize, Mode=TwoWay}">

                <sys:Int32>10</sys:Int32>
                <sys:Int32>20</sys:Int32>
                <sys:Int32>50</sys:Int32>

            </ComboBox>

            <!-- Prev -->
            <Button Content="◀ Prev"
            Style="{StaticResource MaterialDesignOutlinedButton}"
            Click="Prev_Click"
            IsEnabled="{Binding HasPreviousPage}"
            Margin="10,0"/>

            <!-- Page info -->
            <TextBlock Text="{Binding PageInfo}"
               FontSize="16"
               VerticalAlignment="Center"
               Margin="10"/>

            <!-- Next -->
            <Button Content="Next ▶"
            Style="{StaticResource MaterialDesignRaisedButton}"
            Click="Next_Click"
            IsEnabled="{Binding HasNextPage}"
            Margin="10,0"/>

        </StackPanel>
    </Grid>
</Window>